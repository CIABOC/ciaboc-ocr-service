# ============================================================
# CIABOC OCR Service — Environment Configuration
# ============================================================
# Copy this file to .env and update values for your environment.
# NEVER commit the actual .env file to version control.
# ============================================================

# Application
CIABOC_OCR_APP_ENV=development
CIABOC_OCR_APP_TITLE=CIABOC OCR Service
CIABOC_OCR_APP_VERSION=1.0.0

# Server
CIABOC_OCR_HOST=0.0.0.0
CIABOC_OCR_PORT=8000

# OCR
CIABOC_OCR_OCR_LANGUAGE=en
CIABOC_OCR_OCR_DEVICE=cpu
CIABOC_OCR_OCR_MAX_CONCURRENCY=2
CIABOC_OCR_OCR_TIMEOUT_SECONDS=30

# Upload limits
CIABOC_OCR_MAX_UPLOAD_SIZE_MB=10
CIABOC_OCR_MAX_IMAGE_PIXELS=25000000

# Security
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CIABOC_OCR_API_KEY=
CIABOC_OCR_API_KEY_HEADER=X-API-Key
CIABOC_OCR_CORS_ORIGINS=
CIABOC_OCR_RATE_LIMIT_REQUESTS=60
CIABOC_OCR_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
CIABOC_OCR_LOG_LEVEL=INFO
